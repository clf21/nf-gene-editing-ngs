/* Workflow and Process Configuration
 *
 * Sets appropriate ext values under specific conditions
 */

process {
    ext {
        /* Common Task Configuration
         *
         * NOTE These are largely passed through from the params scope
         * for the sake of caching. Not all are present, because some
         * parameters are constructed at runtime. See issues #85 and #86.
         */

        maxReads            = params.maxReads
        maxReadsPerAmplicon = params.maxReadsPerAmplicon
        seed                = params._seed

        summary {
            frameshiftThreshold = params.frameshiftThreshold
            hdrThreshold        = params.hdrThreshold
            unmodifiedThreshold = params.unmodifiedThreshold
            wtFrameshiftMax     = params.wtFrameshiftMax
        }
    }

    /* Tooling Configuration
     *
     * Commands, configuration (where appropriate) and extra arguments
     * for each tool used in the pipeline. Each tool has its own ext
     * entity, each with at least the following properties:
     *
     *   cmd        String[]  Invocation command
     *   extraArgs  String[]  Additional arguments that are always applied
     *
     * TODO (Maybe) Collapse extra configuration, as it's either
     * constant or passed through from params, into extraArgs.
     */

    withLabel: usesBowtie2 {
        ext {
            bowtie2 {
                cmd       = ["bowtie2"]
                extraArgs = []
            }
        }
    }

    withLabel: usesCRISPResso {
        ext {
            crispresso {
                cmd       = ["CRISPResso"]
                extraArgs = [] + (params.crispressoExtraArgs ?: [])

                // CRISPResso defaults
                ext.crispresso.window = params.crispressoWindow
            }
        }
    }

    withLabel: usesFLASH {
        ext {
            flash {
                cmd       = ["flash"]
                extraArgs = []

                // FLASH defaults
                minOverlap = params.mergeMinOverlap
                maxOverlap = params.mergeMaxOverlap
            }
        }
    }

    withLabel: usesSamtools {
        ext {
            samtools {
                cmd       = ["samtools"]
                extraArgs = []
            }
        }
    }

    withLabel: usesTrimmomatic {
        ext {
            trimmomatic {
                cmd       = ["trimmomatic"]
                extraArgs = []

                // Trimmomatic defaults
                adapterPath = "/opt/trimmomatic/adapters/NexteraPE-PE.fa"
                headcrop    = params.trimBases
            }
        }
    }
}
