{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/./master/nextflow_schema.json",
    "title": "GENA Pipeline Parameters",
    "description": "",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input/Output Options",
            "type": "object",
            "required": [
                "fastq_dir",
                "amplicons",
                "outdir"
            ],
            "properties": {
                "fastq_dir": {
                    "type": "string",
                    "description": "Path to sample FASTQs",
                    "format": "directory-path"
                },
                "amplicons": {
                    "type": "string",
                    "description": "Path to amplicons YAML",
                    "format": "file-path",
                    "mimetype": "application/yaml"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Output directory",
                    "default": "output"
                }
            }
        },
        "reference_configuration": {
            "title": "Reference Genome Configuration",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "genome": {
                    "type": "string",
                    "description": "Reference genome ID",
                    "enum": [
                        "hg19",
                        "hg38",
                        "mm10",
                        "rn6"
                    ]
                },
                "genome_dir": {
                    "type": "string",
                    "description": "Reference genome base directory",
                    "default": "ref_genomes",
                    "format": "directory-path"
                }
            },
            "required": [
                "genome"
            ]
        },
        "sample_selection_criteria": {
            "title": "Sample Selection Criteria",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "samples_pattern": {
                    "type": "string",
                    "default": "Illumina",
                    "description": "Sample filename pattern",
                    "enum": [
                        "Illumina"
                    ]
                },
                "samples_include": {
                    "type": "string",
                    "description": "Included sample filenames (exact match, comma-separated)"
                },
                "samples_include_regex": {
                    "type": "string",
                    "description": "Included sample filenames (regular expression)"
                },
                "samples_exclude": {
                    "type": "string",
                    "description": "Excluded sample filenames (exact match, comma-separated)"
                },
                "samples_exclude_regex": {
                    "type": "string",
                    "description": "Excluded sample filenames (regular expression)"
                },
                "samples_process_undetermined": {
                    "type": "boolean",
                    "description": "Process undetermined samples (leave unset to skip undetermined samples)"
                },
                "_samples_skip_undetermined": {
                    "type": "boolean",
                    "default": true,
                    "hidden": true
                }
            },
            "required": []
        },
        "read_count_control": {
            "title": "Read Count Control",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "max_reads": {
                    "type": "integer",
                    "default": 20000,
                    "description": "Read count threshold to trigger downsampling (unset to disable)"
                },
                "min_reads_per_amplicon": {
                    "type": "integer",
                    "default": 500,
                    "description": "Minimum amplicon read overlap count"
                },
                "max_reads_per_amplicon": {
                    "type": "integer",
                    "default": 10000,
                    "description": "Maximum amplicon read overlap count"
                }
            },
            "required": []
        },
        "merging_configuration": {
            "title": "Merging Configuration",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "merge_mode": {
                    "type": "string",
                    "default": "merge",
                    "enum": [
                        "auto",
                        "merge",
                        "both",
                        "no-merge"
                    ],
                    "description": "Paired-end sequences merging strategy"
                },
                "merge_min_overlap": {
                    "type": "integer",
                    "default": 4,
                    "description": "Minimum read overlap count"
                },
                "merge_max_overlap": {
                    "type": "integer",
                    "default": 150,
                    "description": "Maximum read overlap count"
                }
            },
            "required": []
        },
        "trimming_configuration": {
            "title": "Trimming Configuration",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "no_trimming": {
                    "type": "boolean",
                    "description": "Do not perform trimming (unset to trim)"
                },
                "trim_bases": {
                    "type": "integer",
                    "default": 6,
                    "description": "Number of bases to trim"
                },
                "_do_trimming": {
                    "type": "boolean",
                    "default": true,
                    "hidden": true
                }
            },
            "required": []
        },
        "crispresso_configuration": {
            "title": "CRISPResso Configuration",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "crispresso_window": {
                    "type": "integer",
                    "default": 6,
                    "description": "Window (bp) around sgRNA"
                },
                "crispresso_extra_args": {
                    "type": "string",
                    "description": "Additional arguments passed to CRISPResso"
                }
            },
            "required": []
        },
        "summary_configuration": {
            "title": "Summary Configuration",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "frameshift_threshold": {
                    "type": "integer",
                    "default": 85,
                    "description": "Percentage of frameshift reads necessary to call a knockout genotype"
                },
                "hdr_threshold": {
                    "type": "integer",
                    "default": 85,
                    "description": "Percentage of HDR reads necessary to call an HDR genotype"
                },
                "unmodified_threshold": {
                    "type": "integer",
                    "default": 85,
                    "description": "Percentage of unmodified reads necessary to call a wildtype genotype"
                },
                "wt_frameshift_max": {
                    "type": "integer",
                    "default": 5,
                    "description": "Maximum number of frameshift reads that can be present and still call a wildtype genotype"
                }
            },
            "required": []
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/reference_configuration"
        },
        {
            "$ref": "#/definitions/sample_selection_criteria"
        },
        {
            "$ref": "#/definitions/read_count_control"
        },
        {
            "$ref": "#/definitions/merging_configuration"
        },
        {
            "$ref": "#/definitions/trimming_configuration"
        },
        {
            "$ref": "#/definitions/crispresso_configuration"
        },
        {
            "$ref": "#/definitions/summary_configuration"
        }
    ]
}
