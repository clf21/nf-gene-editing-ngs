                    path("${launchDir}/output/SRR16178872-AAVS1_Read2/AAVS1-1/alleles/info.yaml"),
                    path("${launchDir}/output/SRR16178872-AAVS1_Read2/AAVS1-1/alleles/SRR16178872-AAVS1_Read2_AAVS1-1_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR16178872-AAVS1_Read2/AAVS1-1/base-counts/SRR16178872-AAVS1_Read2_AAVS1-1_baseCounts.txt"),
                    path("${launchDir}/output/SRR16178872-AAVS1_Read2/ACTA2.1-KI/skipped.yaml"),
                    path("${launchDir}/output/SRR16178872-AAVS1_Read2/CCR5-1/skipped.yaml"),
                    path("${launchDir}/output/SRR16178872-AAVS1_Read2/EMX1-edit/skipped.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read1/ACTA2.1-KI/alleles/info.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read1/ACTA2.1-KI/alleles/SRR11975752-ACTA2-EcoRI_Read1_ACTA2.1-KI_Frameshift_analysis.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read1/ACTA2.1-KI/alleles/SRR11975752-ACTA2-EcoRI_Read1_ACTA2.1-KI_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read1/ACTA2.1-KI/base-counts/SRR11975752-ACTA2-EcoRI_Read1_ACTA2.1-KI_baseCounts.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read1/CCR5-1/skipped.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read1/AAVS1-1/skipped.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read1/EMX1-edit/skipped.yaml"),
