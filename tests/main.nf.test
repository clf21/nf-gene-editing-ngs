def testDataDir = "tests/nf-core-test-datasets"

nextflow_pipeline {

    name "Full Pipeline Tests"
    tag "pipeline"
    script "main.nf"

    test("Pipeline Defaults, Paired-end") {
        tag "pipeline_defaults_pe"
        tag "pipeline_defaults"
        tag "paired_end"

        when {
            params {
                fastq_dir  = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/fastq")
                genome     = "hg19"
                genome_dir = RelativeDir.to(launchDir, "${baseDir}/ref_genomes")
                amplicons  = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/amplicons.yaml")
                outdir     = "output"
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${launchDir}/output/info.txt"),
                path("${launchDir}/output/info.yaml"),
                path("${launchDir}/output/summary.txt"),
                path("${launchDir}/output/summary.yaml"),
                path("${launchDir}/output/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing
                path("${launchDir}/output/guide_position_base_counts.txt"),

                path("${launchDir}/output/metadata.yaml"),
                path("${launchDir}/output/params.yaml"),
                path("${launchDir}/output/amplicons.yaml"),

                path("${launchDir}/output/B2M/B2M-2/alleles/info.yaml"),
                path("${launchDir}/output/B2M/B2M-2/alleles/B2M_B2M-2_Frameshift_analysis.txt"),
                path("${launchDir}/output/B2M/B2M-2/alleles/B2M_B2M-2_Quantification_of_editing_frequency.txt"),
                path("${launchDir}/output/B2M/B2M-2/base-counts/B2M_B2M-2_baseCounts.txt"),
                path("${launchDir}/output/B2M/FLAG-KI/skipped.yaml"),
                path("${launchDir}/output/B2M/HPRT-ctrl/skipped.yaml"),
                path("${launchDir}/output/B2M/SNP-edit/skipped.yaml"),
                path("${launchDir}/output/FLAG/FLAG-KI/alleles/info.yaml"),
                path("${launchDir}/output/FLAG/FLAG-KI/alleles/FLAG_FLAG-KI_Frameshift_analysis.txt"),
                path("${launchDir}/output/FLAG/FLAG-KI/alleles/FLAG_FLAG-KI_Quantification_of_editing_frequency.txt"),
                path("${launchDir}/output/FLAG/FLAG-KI/base-counts/FLAG_FLAG-KI_baseCounts.txt"),
                path("${launchDir}/output/FLAG/B2M-2/skipped.yaml"),
                path("${launchDir}/output/FLAG/HPRT-ctrl/skipped.yaml"),
                path("${launchDir}/output/FLAG/SNP-edit/skipped.yaml"),
                path("${launchDir}/output/HPRT/HPRT-ctrl/alleles/info.yaml"),
                path("${launchDir}/output/HPRT/HPRT-ctrl/alleles/HPRT_HPRT-ctrl_Quantification_of_editing_frequency.txt"),
                path("${launchDir}/output/HPRT/HPRT-ctrl/base-counts/HPRT_HPRT-ctrl_baseCounts.txt"),
                path("${launchDir}/output/HPRT/B2M-2/skipped.yaml"),
                path("${launchDir}/output/HPRT/FLAG-KI/skipped.yaml"),
                path("${launchDir}/output/HPRT/SNP-edit/skipped.yaml"),
                path("${launchDir}/output/SNP/SNP-edit/alleles/info.yaml"),
                path("${launchDir}/output/SNP/SNP-edit/alleles/SNP_SNP-edit_Quantification_of_editing_frequency.txt"),
                path("${launchDir}/output/SNP/SNP-edit/base-counts/SNP_SNP-edit_baseCounts.txt"),
                path("${launchDir}/output/SNP/B2M-2/skipped.yaml"),
                path("${launchDir}/output/SNP/HPRT-ctrl/skipped.yaml"),
                path("${launchDir}/output/SNP/FLAG-KI/skipped.yaml"),
            ).match()
            assert path("${launchDir}/output/B2M/B2M-2/alleles/CRISPResso_output").exists()
            assert path("${launchDir}/output/FLAG/FLAG-KI/alleles/CRISPResso_output").exists()
            assert path("${launchDir}/output/HPRT/HPRT-ctrl/alleles/CRISPResso_output").exists()
            assert path("${launchDir}/output/SNP/SNP-edit/alleles/CRISPResso_output").exists()
            assert ! path("${launchDir}/output/HPRT/HPRT-ctrl/alleles/HPRT_HPRT-ctrl_Frameshift_analysis.txt").exists()
            assert ! path("${launchDir}/output/SNP/SNP-edit/alleles/SNP_SNP-edit_Frameshift_analysis.txt").exists()
        }
    }

    test("Pipeline Defaults, Single-end") {
        tag "pipeline_defaults_se"
        tag "pipeline_defaults"
        tag "single_end"

        when {
            params {
                fastq_dir  = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/fastq_single-end")
                genome     = "hg19"
                genome_dir = RelativeDir.to(launchDir, "${baseDir}/ref_genomes")
                amplicons  = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/amplicons_single-end.yaml")
                outdir     = "output"
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${launchDir}/output/info.txt"),
                path("${launchDir}/output/info.yaml"),
                path("${launchDir}/output/summary.txt"),
                path("${launchDir}/output/summary.yaml"),
                path("${launchDir}/output/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing
                path("${launchDir}/output/guide_position_base_counts.txt"),

                path("${launchDir}/output/metadata.yaml"),
                path("${launchDir}/output/params.yaml"),
                path("${launchDir}/output/amplicons.yaml"),

                path("${launchDir}/output/B2M_Read1/B2M-2/alleles/error.yaml"),
                path("${launchDir}/output/B2M_Read1/B2M-2/base-counts/skipped.yaml"),
                path("${launchDir}/output/B2M_Read1/FLAG-KI/skipped.yaml"),
                path("${launchDir}/output/B2M_Read1/HPRT-ctrl/skipped.yaml"),
                path("${launchDir}/output/B2M_Read1/SNP-edit/skipped.yaml"),
                path("${launchDir}/output/FLAG_Read1/FLAG-KI/alleles/info.yaml"),
                path("${launchDir}/output/FLAG_Read1/FLAG-KI/alleles/FLAG_Read1_FLAG-KI_Frameshift_analysis.txt"),
                path("${launchDir}/output/FLAG_Read1/FLAG-KI/alleles/FLAG_Read1_FLAG-KI_Quantification_of_editing_frequency.txt"),
                path("${launchDir}/output/FLAG_Read1/B2M-2/skipped.yaml"),
                path("${launchDir}/output/FLAG_Read1/HPRT-ctrl/skipped.yaml"),
                path("${launchDir}/output/FLAG_Read1/SNP-edit/skipped.yaml"),
                path("${launchDir}/output/HPRT_Read1/HPRT-ctrl/alleles/info.yaml"),
                path("${launchDir}/output/HPRT_Read1/HPRT-ctrl/alleles/HPRT_Read1_HPRT-ctrl_Quantification_of_editing_frequency.txt"),
                path("${launchDir}/output/HPRT_Read1/B2M-2/skipped.yaml"),
                path("${launchDir}/output/HPRT_Read1/FLAG-KI/skipped.yaml"),
                path("${launchDir}/output/HPRT_Read1/SNP-edit/skipped.yaml"),
                path("${launchDir}/output/SNP_Read1/SNP-edit/alleles/info.yaml"),
                path("${launchDir}/output/SNP_Read1/SNP-edit/alleles/SNP_Read1_SNP-edit_Quantification_of_editing_frequency.txt"),
                path("${launchDir}/output/SNP_Read1/B2M-2/skipped.yaml"),
                path("${launchDir}/output/SNP_Read1/HPRT-ctrl/skipped.yaml"),
                path("${launchDir}/output/SNP_Read1/FLAG-KI/skipped.yaml"),
            ).match()
            assert path("${launchDir}/output/FLAG_Read1/FLAG-KI/alleles/CRISPResso_output").exists()
            assert path("${launchDir}/output/HPRT_Read1/HPRT-ctrl/alleles/CRISPResso_output").exists()
            assert path("${launchDir}/output/SNP_Read1/SNP-edit/alleles/CRISPResso_output").exists()
            assert ! path("${launchDir}/output/HPRT_Read1/HPRT-ctrl/alleles/HPRT_Read1_HPRT-ctrl_Frameshift_analysis.txt").exists()
            assert ! path("${launchDir}/output/SNP_Read1/SNP-edit/alleles/SNP_Read1_SNP-edit_Frameshift_analysis.txt").exists()
            assert ! path("${launchDir}/output/B2M").exists()
            assert ! path("${launchDir}/output/FLAG").exists()
            assert ! path("${launchDir}/output/HPRT").exists()
            assert ! path("${launchDir}/output/SNP").exists()
        }
    }

    test("One Sample 1000 Reads, Paired-end") {
        tag "one_sample_1k_pe"
        tag "paired_end"
        tag "minimal"

        when {
            params {
                fastq_dir              = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/fastq")
                genome                 = "hg19"
                genome_dir             = RelativeDir.to(launchDir, "${baseDir}/ref_genomes")
                amplicons              = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/amplicons.yaml")
                outdir                 = "output"

                samples_include        = "B2M"
                max_reads              = 1000
                min_reads_per_amplicon = 500
                max_reads_per_amplicon = 10000
                trim_bases             = 6
                merge_mode             = "merge"
                merge_min_overlap      = 4
                merge_max_overlap      = 150
                crispresso_window      = 6
                frameshift_threshold   = 85
                hdr_threshold          = 85
                unmodified_threshold   = 85
                wt_frameshift_max      = 5
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${launchDir}/output/info.txt"),
                path("${launchDir}/output/info.yaml"),
                path("${launchDir}/output/summary.txt"),
                path("${launchDir}/output/summary.yaml"),
                path("${launchDir}/output/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing
                path("${launchDir}/output/guide_position_base_counts.txt"),

                path("${launchDir}/output/metadata.yaml"),
                path("${launchDir}/output/params.yaml"),
                path("${launchDir}/output/amplicons.yaml"),

                path("${launchDir}/output/B2M/B2M-2/alleles/info.yaml"),
                path("${launchDir}/output/B2M/B2M-2/alleles/B2M_B2M-2_Frameshift_analysis.txt"),
                path("${launchDir}/output/B2M/B2M-2/alleles/B2M_B2M-2_Quantification_of_editing_frequency.txt"),
                path("${launchDir}/output/B2M/B2M-2/base-counts/B2M_B2M-2_baseCounts.txt"),
                path("${launchDir}/output/B2M/FLAG-KI/skipped.yaml"),
                path("${launchDir}/output/B2M/HPRT-ctrl/skipped.yaml"),
                path("${launchDir}/output/B2M/SNP-edit/skipped.yaml"),
            ).match()
            assert path("${launchDir}/output/B2M/B2M-2/alleles/CRISPResso_output").exists()
            assert ! path("${launchDir}/output/FLAG").exists()
            assert ! path("${launchDir}/output/HPRT").exists()
            assert ! path("${launchDir}/output/SNP").exists()
        }
    }

    /* Read count control tests *****************************************/

