def testDataDir = "tests/test-data"

nextflow_pipeline {

    name "Full Pipeline Tests"
    tag "pipeline"
    script "main.nf"

    test("Pipeline Defaults, No Metadata") {
        tag "pipeline_defaults_no_meta"
        tag "pipeline_defaults"

        when {
            params {
                fastq_dir  = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/fastq")
                genome     = "hg38"
                genome_dir = RelativeDir.to(launchDir, "${baseDir}/ref_genomes")
                amplicons  = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/amplicons.yaml")
                outdir     = "output"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path("${launchDir}/output/info.txt"),
                    path("${launchDir}/output/info.yaml"),
                    path("${launchDir}/output/summary.txt"),
                    path("${launchDir}/output/summary.yaml"),
                    path("${launchDir}/output/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing
                    path("${launchDir}/output/guide_position_base_counts.txt"),

                    path("${launchDir}/output/metadata.yaml"),
                    path("${launchDir}/output/params.yaml"),
                    path("${launchDir}/output/amplicons.yaml"),

                    path("${launchDir}/output/SRR16178872-AAVS1/AAVS1-1/alleles/info.yaml"),
                    path("${launchDir}/output/SRR16178872-AAVS1/AAVS1-1/alleles/SRR16178872-AAVS1_AAVS1-1_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR16178872-AAVS1/AAVS1-1/base-counts/SRR16178872-AAVS1_AAVS1-1_baseCounts.txt"),
                    path("${launchDir}/output/SRR16178872-AAVS1/ACTA2.1-KI/skipped.yaml"),
                    path("${launchDir}/output/SRR16178872-AAVS1/CCR5-1/skipped.yaml"),
                    path("${launchDir}/output/SRR16178872-AAVS1/EMX1-edit/skipped.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/alleles/info.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/alleles/SRR11975752-ACTA2-EcoRI_ACTA2.1-KI_Frameshift_analysis.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/alleles/SRR11975752-ACTA2-EcoRI_ACTA2.1-KI_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/base-counts/SRR11975752-ACTA2-EcoRI_ACTA2.1-KI_baseCounts.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/AAVS1-1/skipped.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/CCR5-1/skipped.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/EMX1-edit/skipped.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/info.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/SRR16179569-CCR5_CCR5-1_Frameshift_analysis.txt"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/SRR16179569-CCR5_CCR5-1_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/base-counts/SRR16179569-CCR5_CCR5-1_baseCounts.txt"),
                    path("${launchDir}/output/SRR16179569-CCR5/AAVS1-1/skipped.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/ACTA2.1-KI/skipped.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/EMX1-edit/skipped.yaml"),
                    path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1/EMX1-edit/alleles/info.yaml"),
                    path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1/EMX1-edit/alleles/SRR3305503-EMX1-BE3_Read1_EMX1-edit_Frameshift_analysis.txt"),
                    path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1/EMX1-edit/alleles/SRR3305503-EMX1-BE3_Read1_EMX1-edit_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1/EMX1-edit/base-counts/SRR3305503-EMX1-BE3_Read1_EMX1-edit_baseCounts.txt"),
                    path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1/AAVS1-1/skipped.yaml"),
                    path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1/ACTA2.1-KI/skipped.yaml"),
                    path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1/CCR5-1/skipped.yaml"),
                ).match() },
                { assert path("${launchDir}/output/SRR16178872-AAVS1/AAVS1-1/alleles/CRISPResso_output").exists() },
                { assert path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/alleles/CRISPResso_output").exists() },
                { assert path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/CRISPResso_output").exists() },
                { assert path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1/EMX1-edit/alleles/CRISPResso_output").exists() },
                { assert ! path("${launchDir}/output/SRR16178872-AAVS1/AAVS1-1/alleles/SRR16178872-AAVS1_AAVS1-1_Frameshift_analysis.txt").exists() },
            )
        }
    }

    test("One Sample 1000 Reads") {
        tag "one_sample_1k"
        tag "minimal"

        when {
            params {
                fastq_dir              = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/fastq")
                genome                 = "hg38"
                genome_dir             = RelativeDir.to(launchDir, "${baseDir}/ref_genomes")
                amplicons              = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/amplicons.yaml")
                outdir                 = "output"

                samples_include        = "SRR16179569-CCR5"
                max_reads              = 1000
                min_reads_per_amplicon = 250
                max_reads_per_amplicon = 10000
                trim_bases             = 6
                merge_mode             = "merge"
                merge_min_overlap      = 4
                merge_max_overlap      = 150
                crispresso_window      = 6
                frameshift_threshold   = 85
                hdr_threshold          = 85
                unmodified_threshold   = 85
                wt_frameshift_max      = 5
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path("${launchDir}/output/info.txt"),
                    path("${launchDir}/output/info.yaml"),
                    path("${launchDir}/output/summary.txt"),
                    path("${launchDir}/output/summary.yaml"),
                    path("${launchDir}/output/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing
                    path("${launchDir}/output/guide_position_base_counts.txt"),

                    path("${launchDir}/output/metadata.yaml"),
                    path("${launchDir}/output/params.yaml"),
                    path("${launchDir}/output/amplicons.yaml"),

                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/info.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/SRR16179569-CCR5_CCR5-1_Frameshift_analysis.txt"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/SRR16179569-CCR5_CCR5-1_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/base-counts/SRR16179569-CCR5_CCR5-1_baseCounts.txt"),
                    path("${launchDir}/output/SRR16179569-CCR5/AAVS1-1/skipped.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/ACTA2.1-KI/skipped.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/EMX1-edit/skipped.yaml"),
                ).match() },
                { assert path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/CRISPResso_output").exists() },
                { assert ! path("${launchDir}/output/SRR16178872-AAVS1").exists() },
                { assert ! path("${launchDir}/output/SRR11975752-ACTA2-EcoRI").exists() },
                { assert ! path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1").exists() },
            )
        }
    }

    /* Read count control tests *****************************************/

    test("Read Count Control - No Max Reads") {
        tag "read_count_no_max"
        tag "read_count"

        when {
            params {
                fastq_dir              = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/fastq")
                genome                 = "hg38"
                genome_dir             = RelativeDir.to(launchDir, "${baseDir}/ref_genomes")
                amplicons              = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/amplicons.yaml")
                outdir                 = "output"

                // Common parameters for all read count control tests, using two samples
                samples_include        = "SRR11975752-ACTA2-EcoRI,SRR16179569-CCR5"
                trim_bases             = 6
                merge_mode             = "merge"
                merge_min_overlap      = 4
                merge_max_overlap      = 150
                crispresso_window      = 6
                frameshift_threshold   = 85
                hdr_threshold          = 85
                unmodified_threshold   = 85
                wt_frameshift_max      = 5

                max_reads              = 0
                min_reads_per_amplicon = 500
                max_reads_per_amplicon = 10000
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path("${launchDir}/output/info.txt"),
                    path("${launchDir}/output/info.yaml"),
                    path("${launchDir}/output/summary.txt"),
                    path("${launchDir}/output/summary.yaml"),
                    path("${launchDir}/output/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing
                    path("${launchDir}/output/guide_position_base_counts.txt"),

                    path("${launchDir}/output/metadata.yaml"),
                    path("${launchDir}/output/params.yaml"),
                    path("${launchDir}/output/amplicons.yaml"),

                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/alleles/info.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/alleles/SRR11975752-ACTA2-EcoRI_ACTA2.1-KI_Frameshift_analysis.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/alleles/SRR11975752-ACTA2-EcoRI_ACTA2.1-KI_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/base-counts/SRR11975752-ACTA2-EcoRI_ACTA2.1-KI_baseCounts.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/AAVS1-1/skipped.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/CCR5-1/skipped.yaml"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/EMX1-edit/skipped.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/info.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/SRR16179569-CCR5_CCR5-1_Frameshift_analysis.txt"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/SRR16179569-CCR5_CCR5-1_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/base-counts/SRR16179569-CCR5_CCR5-1_baseCounts.txt"),
                    path("${launchDir}/output/SRR16179569-CCR5/AAVS1-1/skipped.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/ACTA2.1-KI/skipped.yaml"),
                    path("${launchDir}/output/SRR16179569-CCR5/EMX1-edit/skipped.yaml"),
                ).match() },
                { assert path("${launchDir}/output/SRR11975752-ACTA2-EcoRI/ACTA2.1-KI/alleles/CRISPResso_output").exists() },
                { assert path("${launchDir}/output/SRR16179569-CCR5/CCR5-1/alleles/CRISPResso_output").exists() },
                { assert ! path("${launchDir}/output/SRR16178872-AAVS1").exists() },
                { assert ! path("${launchDir}/output/SRR3305503-EMX1-BE3_Read1").exists() },
            )
        }
    }

