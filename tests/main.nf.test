                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read2/ACTA2.1-KI/alleles/SRR11975752-ACTA2-EcoRI_Read2_ACTA2.1-KI_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read2/ACTA2.1-KI/base-counts/SRR11975752-ACTA2-EcoRI_Read2_ACTA2.1-KI_baseCounts.txt"),
                    path("${launchDir}/output/SRR11975752-ACTA2-EcoRI_Read2/CCR5-1/skipped.yaml"),
