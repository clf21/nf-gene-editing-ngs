    test("CRISPResso Parameters - 4bp Window, Paired-end") {
        tag "crispresso_window_pe"
        tag "crispresso"
        tag "paired_end"

        when {
            params {
                fastq_dir              = RelativeDir.to(launchDir, "${baseDir}/${testDataDir}/fastq")
