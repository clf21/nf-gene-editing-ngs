                outdir                 = "output"

                // Common parameters for all CRISPResso tests, using two samples
                samples_include        = "B2M,FLAG"
                max_reads              = 10000
                min_reads_per_amplicon = 500
                max_reads_per_amplicon = 10000
                trim_bases             = 6
                merge_mode             = "merge"
