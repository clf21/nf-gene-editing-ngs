    /* Trimming tests ***************************************************/

    test("Trimming - No Trimming, Paired-end") {
        tag "trimming_noTrimming_pe"
        tag "trimming"
        tag "paired_end"

        when {
            params {
                fastqDir            = "$baseDir/tests/nf-core-test-datasets/fastq"
                reference           = "hg19"
                refBase             = "$baseDir/ref_genomes"
                ampliconsYaml       = "$baseDir/tests/nf-core-test-datasets/amplicons.yaml"
                outdir              = "$outputDir"

                // Common parameters for all trimming tests, using two samples
                samplesInclude      = "B2M,FLAG"
                maxReads            = 10000
                minReadsPerAmplicon = 500
                maxReadsPerAmplicon = 10000
                mergeMode           = "merge"
                mergeMinOverlap     = 4
                mergeMaxOverlap     = 150
                crispressoWindow    = 6
                frameshiftThreshold = 85
                hdrThreshold        = 85
                unmodifiedThreshold = 85
                wtFrameshiftMax     = 5

                noTrimming          = true
            }
        }

        then {
            assert workflow.success
