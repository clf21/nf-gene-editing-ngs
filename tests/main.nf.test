nextflow_pipeline {

    name "Full Pipeline Tests"
    tag "pipeline"
    script "main.nf"

    test("Pipeline Defaults, Paired-end") {
        tag "pipeline_defaults_pe"
        tag "pipeline_defaults"
        tag "paired_end"

        when {
            params {
                fastq_dir  = "$baseDir/tests/nf-core-test-datasets/fastq"
                genome     = "hg19"
                genome_dir = "$baseDir/ref_genomes"
                amplicons  = "$baseDir/tests/nf-core-test-datasets/amplicons.yaml"
                outdir     = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${outputDir}/info.txt"),
                path("${outputDir}/info.yaml"),
                path("${outputDir}/summary.txt"),
                path("${outputDir}/summary.yaml"),
                path("${outputDir}/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing

                path("${outputDir}/B2M/B2M-2/info.yaml"),
                path("${outputDir}/B2M/B2M-2/B2M_B2M-2_Frameshift_analysis.txt"),
                path("${outputDir}/B2M/B2M-2/B2M_B2M-2_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/B2M/FLAG-KI/skipped.yaml"),
                path("${outputDir}/B2M/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/B2M/SNP-edit/skipped.yaml"),
                path("${outputDir}/FLAG/FLAG-KI/info.yaml"),
                path("${outputDir}/FLAG/FLAG-KI/FLAG_FLAG-KI_Frameshift_analysis.txt"),
                path("${outputDir}/FLAG/FLAG-KI/FLAG_FLAG-KI_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/FLAG/B2M-2/skipped.yaml"),
                path("${outputDir}/FLAG/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/FLAG/SNP-edit/skipped.yaml"),
                path("${outputDir}/HPRT/HPRT-ctrl/info.yaml"),
                path("${outputDir}/HPRT/HPRT-ctrl/HPRT_HPRT-ctrl_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/HPRT/B2M-2/skipped.yaml"),
                path("${outputDir}/HPRT/FLAG-KI/skipped.yaml"),
                path("${outputDir}/HPRT/SNP-edit/skipped.yaml"),
                path("${outputDir}/SNP/SNP-edit/info.yaml"),
                path("${outputDir}/SNP/SNP-edit/SNP_SNP-edit_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/SNP/B2M-2/skipped.yaml"),
                path("${outputDir}/SNP/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/SNP/FLAG-KI/skipped.yaml"),
            ).match()
            assert path("${outputDir}/B2M/B2M-2/CRISPResso_output").exists()
            assert path("${outputDir}/FLAG/FLAG-KI/CRISPResso_output").exists()
            assert path("${outputDir}/HPRT/HPRT-ctrl/CRISPResso_output").exists()
            assert path("${outputDir}/SNP/SNP-edit/CRISPResso_output").exists()
            assert ! path("${outputDir}/HPRT/HPRT-ctrl/HPRT_HPRT-ctrl_Frameshift_analysis.txt").exists()
            assert ! path("${outputDir}/SNP/SNP-edit/SNP_SNP-edit_Frameshift_analysis.txt").exists()
        }
    }

    test("Pipeline Defaults, Single-end") {
        tag "pipeline_defaults_se"
        tag "pipeline_defaults"
        tag "single_end"

        when {
            params {
                fastq_dir  = "$baseDir/tests/nf-core-test-datasets/fastq_single-end"
                genome     = "hg19"
                genome_dir = "$baseDir/ref_genomes"
                amplicons  = "$baseDir/tests/nf-core-test-datasets/amplicons_single-end.yaml"
                outdir     = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${outputDir}/info.txt"),
                path("${outputDir}/info.yaml"),
                path("${outputDir}/summary.txt"),
                path("${outputDir}/summary.yaml"),
                path("${outputDir}/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing

                path("${outputDir}/B2M_Read1/B2M-2/error.yaml"),
                path("${outputDir}/B2M_Read1/FLAG-KI/skipped.yaml"),
                path("${outputDir}/B2M_Read1/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/B2M_Read1/SNP-edit/skipped.yaml"),
                path("${outputDir}/FLAG_Read1/FLAG-KI/info.yaml"),
                path("${outputDir}/FLAG_Read1/FLAG-KI/FLAG_Read1_FLAG-KI_Frameshift_analysis.txt"),
                path("${outputDir}/FLAG_Read1/FLAG-KI/FLAG_Read1_FLAG-KI_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/FLAG_Read1/B2M-2/skipped.yaml"),
                path("${outputDir}/FLAG_Read1/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/FLAG_Read1/SNP-edit/skipped.yaml"),
                path("${outputDir}/HPRT_Read1/HPRT-ctrl/info.yaml"),
                path("${outputDir}/HPRT_Read1/HPRT-ctrl/HPRT_Read1_HPRT-ctrl_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/HPRT_Read1/B2M-2/skipped.yaml"),
                path("${outputDir}/HPRT_Read1/FLAG-KI/skipped.yaml"),
                path("${outputDir}/HPRT_Read1/SNP-edit/skipped.yaml"),
                path("${outputDir}/SNP_Read1/SNP-edit/info.yaml"),
                path("${outputDir}/SNP_Read1/SNP-edit/SNP_Read1_SNP-edit_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/SNP_Read1/B2M-2/skipped.yaml"),
                path("${outputDir}/SNP_Read1/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/SNP_Read1/FLAG-KI/skipped.yaml"),
            ).match()
            assert path("${outputDir}/FLAG_Read1/FLAG-KI/CRISPResso_output").exists()
            assert path("${outputDir}/HPRT_Read1/HPRT-ctrl/CRISPResso_output").exists()
            assert path("${outputDir}/SNP_Read1/SNP-edit/CRISPResso_output").exists()
            assert ! path("${outputDir}/HPRT_Read1/HPRT-ctrl/HPRT_Read1_HPRT-ctrl_Frameshift_analysis.txt").exists()
            assert ! path("${outputDir}/SNP_Read1/SNP-edit/SNP_Read1_SNP-edit_Frameshift_analysis.txt").exists()
            assert ! path("${outputDir}/B2M").exists()
            assert ! path("${outputDir}/FLAG").exists()
            assert ! path("${outputDir}/HPRT").exists()
            assert ! path("${outputDir}/SNP").exists()
        }
    }

    test("One Sample 1000 Reads, Paired-end") {
        tag "one_sample_1k_pe"
        tag "paired_end"
        tag "minimal"

        when {
            params {
                fastq_dir              = "$baseDir/tests/nf-core-test-datasets/fastq"
                genome                 = "hg19"
                genome_dir             = "$baseDir/ref_genomes"
                amplicons              = "$baseDir/tests/nf-core-test-datasets/amplicons.yaml"
                outdir                 = "$outputDir"

                samples_include        = "B2M"
                max_reads              = 1000
                min_reads_per_amplicon = 500
                max_reads_per_amplicon = 10000
                trim_bases             = 6
                merge_mode             = "merge"
                merge_min_overlap      = 4
                merge_max_overlap      = 150
                crispresso_window      = 6
                frameshift_threshold   = 85
                hdr_threshold          = 85
                unmodified_threshold   = 85
                wt_frameshift_max      = 5
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${outputDir}/info.txt"),
                path("${outputDir}/info.yaml"),
                path("${outputDir}/summary.txt"),
                path("${outputDir}/summary.yaml"),
                path("${outputDir}/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing

                path("${outputDir}/B2M/B2M-2/info.yaml"),
                path("${outputDir}/B2M/B2M-2/B2M_B2M-2_Frameshift_analysis.txt"),
                path("${outputDir}/B2M/B2M-2/B2M_B2M-2_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/B2M/FLAG-KI/skipped.yaml"),
                path("${outputDir}/B2M/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/B2M/SNP-edit/skipped.yaml"),
            ).match()
            assert path("${outputDir}/B2M/B2M-2/CRISPResso_output").exists()
            assert ! path("${outputDir}/FLAG").exists()
            assert ! path("${outputDir}/HPRT").exists()
            assert ! path("${outputDir}/SNP").exists()
        }
    }

    /* Read count control tests *****************************************/

    test("Read Count Control - No Max Reads, Paired-end") {
        tag "read_count_no_max_pe"
        tag "read_count"
        tag "paired_end"

        when {
            params {
                fastq_dir              = "$baseDir/tests/nf-core-test-datasets/fastq"
                genome                 = "hg19"
                genome_dir             = "$baseDir/ref_genomes"
                amplicons              = "$baseDir/tests/nf-core-test-datasets/amplicons.yaml"
                outdir                 = "$outputDir"

                // Common parameters for all read count control tests, using two samples
                samples_include        = "B2M,FLAG"
                trim_bases             = 6
                merge_mode             = "merge"
                merge_min_overlap      = 4
                merge_max_overlap      = 150
                crispresso_window      = 6
                frameshift_threshold   = 85
                hdr_threshold          = 85
                unmodified_threshold   = 85
                wt_frameshift_max      = 5

                max_reads              = 0
                min_reads_per_amplicon = 500
                max_reads_per_amplicon = 10000
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${outputDir}/info.txt"),
                path("${outputDir}/info.yaml"),
                path("${outputDir}/summary.txt"),
                path("${outputDir}/summary.yaml"),
                path("${outputDir}/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing

                path("${outputDir}/B2M/B2M-2/info.yaml"),
                path("${outputDir}/B2M/B2M-2/B2M_B2M-2_Frameshift_analysis.txt"),
                path("${outputDir}/B2M/B2M-2/B2M_B2M-2_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/B2M/FLAG-KI/skipped.yaml"),
                path("${outputDir}/B2M/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/B2M/SNP-edit/skipped.yaml"),
                path("${outputDir}/FLAG/FLAG-KI/info.yaml"),
                path("${outputDir}/FLAG/FLAG-KI/FLAG_FLAG-KI_Frameshift_analysis.txt"),
                path("${outputDir}/FLAG/FLAG-KI/FLAG_FLAG-KI_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/FLAG/B2M-2/skipped.yaml"),
                path("${outputDir}/FLAG/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/FLAG/SNP-edit/skipped.yaml"),
            ).match()
            assert path("${outputDir}/B2M/B2M-2/CRISPResso_output").exists()
            assert path("${outputDir}/FLAG/FLAG-KI/CRISPResso_output").exists()
            assert ! path("${outputDir}/HPRT").exists()
            assert ! path("${outputDir}/SNP").exists()
        }
    }

