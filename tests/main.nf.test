                path("${outputDir}/FLAG/B2M-2/skipped.yaml"),
                path("${outputDir}/FLAG/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/FLAG/SNP-edit/skipped.yaml"),
                path("${outputDir}/FLAG_Read1/B2M-2/skipped.yaml"),
                path("${outputDir}/FLAG_Read1/FLAG-KI/skipped.yaml"),
                path("${outputDir}/FLAG_Read1/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/FLAG_Read1/SNP-edit/skipped.yaml"),
                path("${outputDir}/FLAG_Read2/FLAG-KI/info.yaml"),
                path("${outputDir}/FLAG_Read2/FLAG-KI/FLAG_Read2_FLAG-KI_Frameshift_analysis.txt"),
                path("${outputDir}/FLAG_Read2/FLAG-KI/FLAG_Read2_FLAG-KI_Quantification_of_editing_frequency.txt"),
                path("${outputDir}/FLAG_Read2/B2M-2/skipped.yaml"),
                path("${outputDir}/FLAG_Read2/HPRT-ctrl/skipped.yaml"),
