                merge_max_overlap      = 150
                crispresso_window      = 6
                frameshift_threshold   = 85
                hdr_threshold          = 85
                unmodified_threshold   = 85
                wt_frameshift_max      = 5

                merge_mode             = "no-merge"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path("${launchDir}/output/info.txt"),
                    path("${launchDir}/output/info.yaml"),
                    path("${launchDir}/output/summary.txt"),
                    path("${launchDir}/output/summary.yaml"),
                    path("${launchDir}/output/alleles_frequency_table.txt.gz"), // nf-test unzips file before hashing
                    path("${launchDir}/output/guide_position_base_counts.txt"),

                    path("${launchDir}/output/metadata.yaml"),
                    path("${launchDir}/output/params.yaml"),
                    path("${launchDir}/output/amplicons.yaml"),

                    path("${launchDir}/output/SRR16178872-AAVS1_Read1/AAVS1-1/alleles/info.yaml"),
                    path("${launchDir}/output/SRR16178872-AAVS1_Read1/AAVS1-1/alleles/SRR16178872-AAVS1_Read1_AAVS1-1_Quantification_of_editing_frequency.txt"),
                    path("${launchDir}/output/SRR16178872-AAVS1_Read1/AAVS1-1/base-counts/SRR16178872-AAVS1_Read1_AAVS1-1_baseCounts.txt"),
                    path("${launchDir}/output/SRR16178872-AAVS1_Read1/ACTA2.1-KI/skipped.yaml"),
                    path("${launchDir}/output/SRR16178872-AAVS1_Read1/CCR5-1/skipped.yaml"),
