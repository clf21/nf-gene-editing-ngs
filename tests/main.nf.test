    /* Trimming tests ***************************************************/

    test("Trimming - No Trimming, Paired-end") {
        tag "trimming_no_trimming_pe"
        tag "trimming"
        tag "paired_end"

        when {
            params {
                fastq_dir              = "$baseDir/tests/nf-core-test-datasets/fastq"
                genome                 = "hg19"
                genome_dir             = "$baseDir/ref_genomes"
                amplicons              = "$baseDir/tests/nf-core-test-datasets/amplicons.yaml"
                outdir                 = "$outputDir"

                // Common parameters for all trimming tests, using two samples
                samples_include        = "B2M,FLAG"
                max_reads              = 10000
                min_reads_per_amplicon = 500
                max_reads_per_amplicon = 10000
                merge_mode             = "merge"
                merge_min_overlap      = 4
                merge_max_overlap      = 150
                crispresso_window      = 6
                frameshift_threshold   = 85
                hdr_threshold          = 85
                unmodified_threshold   = 85
                wt_frameshift_max      = 5

                no_trimming            = true
