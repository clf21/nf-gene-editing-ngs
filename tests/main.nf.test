                path("${outputDir}/B2M_Read1/B2M-2/skipped.yaml"),
                path("${outputDir}/B2M_Read1/FLAG-KI/skipped.yaml"),
                path("${outputDir}/B2M_Read1/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/B2M_Read1/SNP-edit/skipped.yaml"),
                path("${outputDir}/B2M_Read2/B2M-2/skipped.yaml"),
                path("${outputDir}/B2M_Read2/FLAG-KI/skipped.yaml"),
                path("${outputDir}/B2M_Read2/HPRT-ctrl/skipped.yaml"),
                path("${outputDir}/B2M_Read2/SNP-edit/skipped.yaml"),
                path("${outputDir}/FLAG/FLAG-KI/info.yaml"),
