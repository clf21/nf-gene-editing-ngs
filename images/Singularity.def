Bootstrap: docker
From: alpine:3.21

%files
    baseCounts /opt/build-files/baseCounts

%post
    # Install build dependencies
    apk --no-cache add \
        build-base \
        bzip2-dev \
        curl-dev \
        freetype-dev \
        libpng-dev \
        libtbb-dev \
        ncurses-dev \
        openblas-dev \
        openjdk11 \
        perl-app-cpanminus \
        perl-dev \
        python3-dev \
        py3-pip \
        py3-virtualenv \
        wget \
        xz-dev \
        zlib-dev

    # Build Bowtie2 2.5.5
    mkdir -p /tmp/bowtie2
    cd /tmp/bowtie2
    wget -O bowtie2.tar.gz https://github.com/BenLangmead/bowtie2/archive/refs/tags/v2.5.5.tar.gz
    tar -xf bowtie2.tar.gz
    cd bowtie2-2.5.5
    # Note: Skip bowtie2.patch - it's for 2.3.4.3 and just fixes trailing whitespace
    make
    mkdir -p /opt/bowtie2/bin
    cp bowtie2* /opt/bowtie2/bin/

    # Install CRISPResso2 from source (Python 3 compatible)
    mkdir -p /tmp/CRISPResso2
    cd /tmp/CRISPResso2
    wget -O CRISPResso2.zip https://github.com/pinellolab/CRISPResso2/archive/refs/heads/master.zip
    unzip -o CRISPResso2.zip
    cd CRISPResso2-master

    # Create venv and install
    python3 -m venv /opt/CRISPResso2/venv
    . /opt/CRISPResso2/venv/bin/activate
    pip install --upgrade pip
    pip install -e .
    deactivate

    # Skip EMBOSS - not used in pipeline and FTP server unreliable

    # Build Samtools 1.23.1
    mkdir -p /tmp/samtools
    cd /tmp/samtools
    wget -O samtools.tar.bz2 https://github.com/samtools/samtools/releases/download/1.23.1/samtools-1.23.1.tar.bz2
    tar -xf samtools.tar.bz2
    cd samtools-1.23.1
    ./configure --prefix=/opt/samtools
    make
    make install

    # Download Trimmomatic 0.39 (latest stable release)
    mkdir -p /tmp/trimmomatic
    cd /tmp/trimmomatic
    wget -O trimmomatic.zip http://www.usadellab.org/cms/uploads/supplementary/Trimmomatic/Trimmomatic-0.39.zip
    unzip -o trimmomatic.zip
    mkdir -p /opt/trimmomatic
    cp -r Trimmomatic-0.39/* /opt/trimmomatic/

    # Install Perl dependencies
    cpanm YAML::XS

    # Build guide position base counting tool
    cd /opt/build-files/baseCounts
    ./mvnw clean package
    mkdir -p /opt/base-counts/lib
    cp target/GeneEditing-*-jar-with-dependencies.jar /opt/base-counts/lib/GeneEditing.jar

    # Install runtime dependencies
    apk --no-cache add \
        bash \
        coreutils \
        freetype \
        graphviz \
        libbz2 \
        libcurl \
        libpng \
        libtbb \
        ncurses-libs \
        openblas \
        openjdk11-jre-headless \
        perl \
        python3 \
        py3-pip \
        xz-libs \
        zlib

    # Create wrapper scripts for CRISPResso2
    mkdir -p /opt/CRISPResso2/bin
    cat > /opt/CRISPResso2/bin/_crispresso <<'EOF'
#!/bin/sh
. /opt/CRISPResso2/venv/bin/activate
"$(basename "$0")" "$@"
EOF
    chmod 755 /opt/CRISPResso2/bin/_crispresso

    cd /opt/CRISPResso2/bin
    ln -s _crispresso CRISPResso
    ln -s _crispresso CRISPResso2
    ln -s _crispresso CRISPRessoCompare
    ln -s _crispresso CRISPRessoWGS
    ln -s _crispresso CRISPRessoPooled
    ln -s _crispresso CRISPRessoAggregate

    cat > /opt/trimmomatic/bin/trimmomatic <<'EOF'
#!/bin/sh
exec java -jar /opt/trimmomatic/trimmomatic-0.39.jar "$@"
EOF
    chmod 755 /opt/trimmomatic/bin/trimmomatic

    cat > /opt/base-counts/bin/computeBaseCounts <<'EOF'
#!/bin/sh
exec java -jar /opt/base-counts/lib/GeneEditing.jar "$@"
EOF
    chmod 755 /opt/base-counts/bin/computeBaseCounts

    # Run CRISPResso2 once to generate font cache
    /opt/CRISPResso2/bin/CRISPResso -h >/dev/null || true

    # Cleanup
    rm -rf /tmp/*
    rm -rf /opt/build-files

%environment
    export PATH=$PATH:/opt/bowtie2/bin:/opt/CRISPResso2/bin:/opt/samtools/bin:/opt/trimmomatic/bin:/opt/base-counts/bin

%labels
    Author nf-gene-editing-ngs
    Version 2.0.0
    Description Phase 2 - Full migration to CRISPResso2 and Python 3
