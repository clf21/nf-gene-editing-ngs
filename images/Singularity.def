Bootstrap: docker
From: alpine:3.15

%files
    bowtie2.patch /build/bowtie2.patch
    install-CRISPResso.sh /build/install-CRISPResso.sh
    CRISPResso.patch /build/CRISPResso.patch
    baseCounts /build/baseCounts

%post
    # Install build dependencies
    apk --no-cache add \
        build-base \
        bzip2-dev \
        curl-dev \
        freetype-dev \
        libpng-dev \
        libtbb-dev \
        ncurses-dev \
        openblas-dev \
        openjdk11 \
        perl-app-cpanminus \
        perl-dev \
        python2-dev \
        wget \
        xz-dev \
        zlib-dev

    # Build Bowtie2 2.3.4.3
    mkdir -p /tmp/bowtie2
    cd /tmp/bowtie2
    wget -O bowtie2.zip https://downloads.sourceforge.net/project/bowtie-bio/bowtie2/2.3.4.3/bowtie2-2.3.4.3-source.zip
    unzip -o bowtie2.zip
    patch -p0 < /build/bowtie2.patch
    cd bowtie2-2.3.4.3
    make
    mkdir -p /opt/bowtie2/bin
    cp bowtie2 bowtie2-align-s bowtie2-align-l bowtie2-build bowtie2-build-s bowtie2-build-l bowtie2-inspect bowtie2-inspect-s bowtie2-inspect-l /opt/bowtie2/bin/

    # Build CRISPResso v1 with custom patches
    mkdir -p /tmp/CRISPResso
    cd /tmp/CRISPResso
    wget -O CRISPResso.zip https://github.com/lucapinello/CRISPResso/archive/master.zip
    unzip -o CRISPResso.zip
    patch -p0 < /build/CRISPResso.patch
    cd CRISPResso-master/dependencies
    tar -xf FLASH-1.2.11.tar.gz
    cd FLASH-1.2.11
    make
    mkdir -p /opt/CRISPResso/bin
    cp flash /opt/CRISPResso/bin/
    cd /tmp/CRISPResso
    python -m ensurepip
    pip install virtualenv
    chmod +x /build/install-CRISPResso.sh
    /build/install-CRISPResso.sh /tmp/CRISPResso/CRISPResso-master /opt/CRISPResso/venv

    # Build EMBOSS 6.6.0 (required by CRISPResso v1 for needle alignment)
    # Using GitHub mirror instead of unreliable FTP server
    mkdir -p /tmp/emboss
    cd /tmp/emboss
    # Try multiple sources in order of preference
    if wget -O emboss.tar.gz https://github.com/kimrutherford/EMBOSS/archive/refs/tags/EMBOSS-6.6.0.tar.gz 2>/dev/null; then
        echo "INFO: Downloaded EMBOSS from GitHub"
        tar -xf emboss.tar.gz
        cd EMBOSS-EMBOSS-6.6.0
    elif wget -O emboss.tar.gz http://emboss.open-bio.org/rel/EMBOSS/EMBOSS-6.6.0.tar.gz 2>/dev/null; then
        echo "INFO: Downloaded EMBOSS from HTTP mirror"
        tar -xf emboss.tar.gz
        cd EMBOSS-6.6.0
    elif wget -O emboss.tar.gz ftp://emboss.open-bio.org/pub/EMBOSS/EMBOSS-6.6.0.tar.gz 2>/dev/null; then
        echo "INFO: Downloaded EMBOSS from FTP"
        tar -xf emboss.tar.gz
        cd EMBOSS-6.6.0
    else
        echo "ERROR: Could not download EMBOSS from any source"
        exit 1
    fi
    # Configure and build
    ./configure --prefix=/opt/emboss --without-x --disable-shared --enable-static
    make
    # Manual install: copy binaries directly to avoid problematic install-exec-hook
    # The hook tries to download data files which fails in restricted networks
    mkdir -p /opt/emboss/bin /opt/emboss/share/EMBOSS
    echo "INFO: Installing EMBOSS binaries manually"
    # Copy all compiled binaries from emboss subdirectory
    find emboss -maxdepth 1 -type f -executable -exec cp {} /opt/emboss/bin/ \;
    # Verify needle is present (critical for CRISPResso)
    if [ ! -f /opt/emboss/bin/needle ]; then
        echo "ERROR: needle binary not found after build"
        ls -la emboss/needle* || true
        exit 1
    fi
    chmod 755 /opt/emboss/bin/*
    echo "INFO: EMBOSS installed - $(ls /opt/emboss/bin/ | wc -l) binaries including needle"

    # Build Samtools 1.9
    mkdir -p /tmp/samtools
    cd /tmp/samtools
    wget -O samtools.tar.gz https://github.com/samtools/samtools/releases/download/1.9/samtools-1.9.tar.bz2
    tar -xf samtools.tar.gz
    cd samtools-1.9
    ./configure --prefix=/opt/samtools
    make
    make install

    # Download Trimmomatic 0.39
    mkdir -p /tmp/trimmomatic
    cd /tmp/trimmomatic
    wget -O trimmomatic.zip https://github.com/usadellab/Trimmomatic/files/5854859/Trimmomatic-0.39.zip
    unzip -o trimmomatic.zip
    mkdir -p /opt/trimmomatic/bin
    cp -r Trimmomatic-0.39/* /opt/trimmomatic/

    # Install Perl dependencies
    cpanm YAML::XS

    # Build guide position base counting tool (optional - may fail on HPC without Maven Central access)
    cd /build/baseCounts
    if ./mvnw clean package; then
        echo "INFO: baseCounts built successfully"
        mkdir -p /opt/base-counts/lib
        cp target/GeneEditing-*-jar-with-dependencies.jar /opt/base-counts/lib/GeneEditing.jar
    else
        echo "WARNING: baseCounts build failed - Maven Central may be blocked"
        echo "WARNING: Guide position base counting will not be available"
        echo "WARNING: Build continues without baseCounts"
    fi

    # Install runtime dependencies
    apk --no-cache add \
        bash \
        coreutils \
        freetype \
        graphviz \
        libbz2 \
        libcurl \
        libpng \
        libtbb \
        ncurses-libs \
        openblas \
        openjdk11-jre-headless \
        perl \
        python2 \
        xz-libs \
        zlib

    # Create wrapper scripts for CRISPResso v1
    mkdir -p /opt/CRISPResso/bin
    cat > /opt/CRISPResso/bin/_crispresso <<'EOF'
#!/bin/sh
. /opt/CRISPResso/venv/bin/activate
"$(basename "$0")" "$@"
EOF
    chmod 755 /opt/CRISPResso/bin/_crispresso

    cd /opt/CRISPResso/bin
    ln -s _crispresso CRISPResso
    ln -s _crispresso CRISPRessoCompare
    ln -s _crispresso CRISPRessoCount
    ln -s _crispresso CRISPRessoPooled
    ln -s _crispresso CRISPRessoPooledWGSCompare
    ln -s _crispresso CRISPRessoWGS

    cat > /opt/trimmomatic/bin/trimmomatic <<'EOF'
#!/bin/sh
exec java -jar /opt/trimmomatic/trimmomatic-0.39.jar "$@"
EOF
    chmod 755 /opt/trimmomatic/bin/trimmomatic

    # Create wrapper only if JAR was built
    if [ -f /opt/base-counts/lib/GeneEditing.jar ]; then
        mkdir -p /opt/base-counts/bin
        cat > /opt/base-counts/bin/computeBaseCounts <<'EOF'
#!/bin/sh
exec java -jar /opt/base-counts/lib/GeneEditing.jar "$@"
EOF
        chmod 755 /opt/base-counts/bin/computeBaseCounts
        echo "INFO: computeBaseCounts wrapper created"
    else
        echo "WARNING: Skipping computeBaseCounts wrapper (JAR not built)"
    fi

    # Run CRISPResso once to generate font cache
    # Add CRISPResso bin to PATH temporarily for build-time execution
    export PATH=$PATH:/opt/CRISPResso/bin
    /opt/CRISPResso/bin/CRISPResso -h >/dev/null 2>&1 || echo "INFO: Font cache generation skipped (will be created on first run)"

    # Skip cleanup - causes permission errors and increases image size slightly but ensures build succeeds
    # This is expected behavior on HPC systems with --ignore-fakeroot-command
    echo "INFO: Skipping cleanup to ensure successful build"

%environment
    export PATH=$PATH:/opt/bowtie2/bin:/opt/CRISPResso/bin:/opt/emboss/bin:/opt/samtools/bin:/opt/trimmomatic/bin:/opt/base-counts/bin

%labels
    Author nf-gene-editing-ngs
    Version 1.2
    Description CRISPResso v1 with Python 2.7 (AGPL licensed)
