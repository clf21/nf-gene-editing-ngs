Bootstrap: docker
From: alpine:3.15

%files
    bowtie2.patch /build/bowtie2.patch
    install-CRISPResso.sh /build/install-CRISPResso.sh
    CRISPResso.patch /build/CRISPResso.patch
    baseCounts /build/baseCounts

%post
    # Install build dependencies
    apk --no-cache add \
        build-base \
        bzip2-dev \
        curl-dev \
        freetype-dev \
        libpng-dev \
        libtbb-dev \
        ncurses-dev \
        openblas-dev \
        openjdk11 \
        perl-app-cpanminus \
        perl-dev \
        python2-dev \
        wget \
        xz-dev \
        zlib-dev

    # Build Bowtie2 2.3.4.3
    mkdir -p /tmp/bowtie2
    cd /tmp/bowtie2
    wget -O bowtie2.zip https://downloads.sourceforge.net/project/bowtie-bio/bowtie2/2.3.4.3/bowtie2-2.3.4.3-source.zip
    unzip -o bowtie2.zip
    patch -p0 < /build/bowtie2.patch
    cd bowtie2-2.3.4.3
    make
    mkdir -p /opt/bowtie2/bin
    cp bowtie2 bowtie2-align-s bowtie2-align-l bowtie2-build bowtie2-build-s bowtie2-build-l bowtie2-inspect bowtie2-inspect-s bowtie2-inspect-l /opt/bowtie2/bin/

    # Build CRISPResso v1 with custom patches
    mkdir -p /tmp/CRISPResso
    cd /tmp/CRISPResso
    wget -O CRISPResso.zip https://github.com/lucapinello/CRISPResso/archive/master.zip
    unzip -o CRISPResso.zip
    patch -p0 < /build/CRISPResso.patch
    cd CRISPResso-master/dependencies
    tar -xf FLASH-1.2.11.tar.gz
    cd FLASH-1.2.11
    make
    mkdir -p /opt/CRISPResso/bin
    cp flash /opt/CRISPResso/bin/
    cd /tmp/CRISPResso
    python -m ensurepip
    pip install virtualenv
    chmod +x /build/install-CRISPResso.sh
    /build/install-CRISPResso.sh /tmp/CRISPResso/CRISPResso-master /opt/CRISPResso/venv

    # Build EMBOSS 6.6.0
    mkdir -p /tmp/emboss
    cd /tmp/emboss
    wget -O emboss.tar.gz ftp://emboss.open-bio.org/pub/EMBOSS/EMBOSS-6.6.0.tar.gz
    tar -xf emboss.tar.gz
    cd EMBOSS-6.6.0
    ./configure --prefix=/opt/emboss --without-x
    make
    make install

    # Build Samtools 1.9
    mkdir -p /tmp/samtools
    cd /tmp/samtools
    wget -O samtools.tar.gz https://github.com/samtools/samtools/releases/download/1.9/samtools-1.9.tar.bz2
    tar -xf samtools.tar.gz
    cd samtools-1.9
    ./configure --prefix=/opt/samtools
    make
    make install

    # Download Trimmomatic 0.39
    mkdir -p /tmp/trimmomatic
    cd /tmp/trimmomatic
    wget -O trimmomatic.zip https://github.com/usadellab/Trimmomatic/files/5854859/Trimmomatic-0.39.zip
    unzip -o trimmomatic.zip
    mkdir -p /opt/trimmomatic/bin
    cp -r Trimmomatic-0.39/* /opt/trimmomatic/

    # Install Perl dependencies
    cpanm YAML::XS

    # Build guide position base counting tool
    cd /build/baseCounts
    ./mvnw clean package
    mkdir -p /opt/base-counts/lib
    cp target/GeneEditing-*-jar-with-dependencies.jar /opt/base-counts/lib/GeneEditing.jar

    # Install runtime dependencies
    apk --no-cache add \
        bash \
        coreutils \
        freetype \
        graphviz \
        libbz2 \
        libcurl \
        libpng \
        libtbb \
        ncurses-libs \
        openblas \
        openjdk11-jre-headless \
        perl \
        python2 \
        xz-libs \
        zlib

    # Create wrapper scripts for CRISPResso v1
    mkdir -p /opt/CRISPResso/bin
    cat > /opt/CRISPResso/bin/_crispresso <<'EOF'
#!/bin/sh
. /opt/CRISPResso/venv/bin/activate
"$(basename "$0")" "$@"
EOF
    chmod 755 /opt/CRISPResso/bin/_crispresso

    cd /opt/CRISPResso/bin
    ln -s _crispresso CRISPResso
    ln -s _crispresso CRISPRessoCompare
    ln -s _crispresso CRISPRessoCount
    ln -s _crispresso CRISPRessoPooled
    ln -s _crispresso CRISPRessoPooledWGSCompare
    ln -s _crispresso CRISPRessoWGS

    cat > /opt/trimmomatic/bin/trimmomatic <<'EOF'
#!/bin/sh
exec java -jar /opt/trimmomatic/trimmomatic-0.39.jar "$@"
EOF
    chmod 755 /opt/trimmomatic/bin/trimmomatic

    cat > /opt/base-counts/bin/computeBaseCounts <<'EOF'
#!/bin/sh
exec java -jar /opt/base-counts/lib/GeneEditing.jar "$@"
EOF
    chmod 755 /opt/base-counts/bin/computeBaseCounts

    # Run CRISPResso once to generate font cache
    /opt/CRISPResso/bin/CRISPResso -h >/dev/null || true

    # Cleanup
    rm -rf /tmp/*

%environment
    export PATH=$PATH:/opt/bowtie2/bin:/opt/CRISPResso/bin:/opt/emboss/bin:/opt/samtools/bin:/opt/trimmomatic/bin:/opt/base-counts/bin

%labels
    Author nf-gene-editing-ngs
    Version 1.2
    Description CRISPResso v1 with Python 2.7 (AGPL licensed)
