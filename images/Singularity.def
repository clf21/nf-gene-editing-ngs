Bootstrap: docker
From: alpine:3.21

%files
    bowtie2.patch /tmp/bowtie2.patch
    install-CRISPResso.sh /tmp/install-CRISPResso.sh
    CRISPResso.patch /tmp/CRISPResso.patch
    baseCounts /tmp/baseCounts

%post
    # Install build dependencies
    apk --no-cache add \
        build-base \
        bzip2-dev \
        curl-dev \
        freetype-dev \
        libpng-dev \
        libtbb-dev \
        ncurses-dev \
        openblas-dev \
        openjdk11 \
        perl-app-cpanminus \
        perl-dev \
        python3-dev \
        wget \
        xz-dev \
        zlib-dev

    # Build Bowtie2 2.5.5
    mkdir -p /tmp/bowtie2
    cd /tmp/bowtie2
    cp /tmp/bowtie2.patch .
    wget -O bowtie2.tar.gz https://github.com/BenLangmead/bowtie2/archive/refs/tags/v2.5.5.tar.gz
    tar -xf bowtie2.tar.gz
    patch -p0 < bowtie2.patch
    cd bowtie2-2.5.5
    make
    mkdir -p /opt/bowtie2/bin
    cp bowtie2* /opt/bowtie2/bin/

    # Build CRISPResso (master)
    mkdir -p /tmp/CRISPResso
    cd /tmp/CRISPResso
    cp /tmp/CRISPResso.patch .
    cp /tmp/install-CRISPResso.sh .
    wget -O CRISPResso.zip https://github.com/lucapinello/CRISPResso/archive/master.zip
    unzip CRISPResso.zip
    patch -p0 < CRISPResso.patch
    cd CRISPResso-master/dependencies
    tar -xf FLASH-1.2.11.tar.gz
    cd FLASH-1.2.11
    make
    cd ../../..
    python -m ensurepip
    pip install virtualenv
    chmod +x install-CRISPResso.sh
    ./install-CRISPResso.sh /tmp/CRISPResso/CRISPResso-master /opt/CRISPResso/venv
    mkdir -p /opt/CRISPResso/bin
    cp /tmp/CRISPResso/CRISPResso-master/dependencies/FLASH-1.2.11/flash /opt/CRISPResso/bin/

    # Build EMBOSS 6.6.0
    mkdir -p /tmp/emboss
    cd /tmp/emboss
    wget -O emboss.tar.gz ftp://emboss.open-bio.org/pub/EMBOSS/EMBOSS-6.6.0.tar.gz
    tar -xf emboss.tar.gz
    cd EMBOSS-6.6.0
    ./configure --prefix=/opt/emboss --without-x
    make
    make install

    # Build Samtools 1.23.1
    mkdir -p /tmp/samtools
    cd /tmp/samtools
    wget -O samtools.tar.bz2 https://github.com/samtools/samtools/releases/download/1.23.1/samtools-1.23.1.tar.bz2
    tar -xf samtools.tar.bz2
    cd samtools-1.23.1
    ./configure --prefix=/opt/samtools
    make
    make install

    # Download Trimmomatic 0.41
    mkdir -p /tmp/trimmomatic
    cd /tmp/trimmomatic
    wget -O trimmomatic.zip https://github.com/usadellab/Trimmomatic/files/14508250/Trimmomatic-0.41.zip
    unzip trimmomatic.zip
    mkdir -p /opt/trimmomatic
    cp -r Trimmomatic-0.41/* /opt/trimmomatic/

    # Install Perl dependencies
    cpanm YAML::XS

    # Build guide position base counting tool
    cd /tmp/baseCounts
    ./mvnw clean package
    mkdir -p /opt/base-counts/lib
    cp target/GeneEditing-*-jar-with-dependencies.jar /opt/base-counts/lib/GeneEditing.jar

    # Install runtime dependencies
    apk --no-cache add \
        bash \
        coreutils \
        freetype \
        graphviz \
        libbz2 \
        libcurl \
        libpng \
        libtbb \
        ncurses-libs \
        openblas \
        openjdk11-jre-headless \
        perl \
        python3 \
        xz-libs \
        zlib

    # Create wrapper scripts
    cat > /opt/CRISPResso/bin/_crispresso <<'EOF'
#!/bin/sh
. /opt/CRISPResso/venv/bin/activate
"$(basename "$0")" "$@"
EOF
    chmod 755 /opt/CRISPResso/bin/_crispresso

    cd /opt/CRISPResso/bin
    ln -s _crispresso CRISPResso
    ln -s _crispresso CRISPRessoCompare
    ln -s _crispresso CRISPRessoCount
    ln -s _crispresso CRISPRessoPooled
    ln -s _crispresso CRISPRessoPooledWGSCompare
    ln -s _crispresso CRISPRessoWGS

    cat > /opt/trimmomatic/bin/trimmomatic <<'EOF'
#!/bin/sh
exec java -jar /opt/trimmomatic/trimmomatic-0.41.jar "$@"
EOF
    chmod 755 /opt/trimmomatic/bin/trimmomatic

    cat > /opt/base-counts/bin/computeBaseCounts <<'EOF'
#!/bin/sh
exec java -jar /opt/base-counts/lib/GeneEditing.jar "$@"
EOF
    chmod 755 /opt/base-counts/bin/computeBaseCounts

    # Run CRISPResso once to generate font cache
    /opt/CRISPResso/bin/CRISPResso -h >/dev/null || true

    # Cleanup
    rm -rf /tmp/*

%environment
    export PATH=$PATH:/opt/bowtie2/bin:/opt/CRISPResso/bin:/opt/emboss/bin:/opt/samtools/bin:/opt/trimmomatic/bin:/opt/base-counts/bin

%labels
    Author nf-gene-editing-ngs
    Version 1.3.0-phase1
